---
import { Image } from 'astro:assets'
import avatar from '~/assets/profile/nari.jpg'
import { profile } from '~/data/profile'

const lines = ['Takashi', 'Narikawa']
const socials = [
  { label: 'GitHub', href: profile.links.github },
  { label: 'X', href: profile.links.x },
  { label: 'LinkedIn', href: profile.links.linkedin },
  { label: 'Speaker Deck', href: profile.links.speakerdeck },
]
---

<section
  id="top"
  class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-yolk text-ink"
  data-hero
>
  <!-- White brush streaks, echoing the painted wall behind the avatar. Drawn by the cursor, fades on its own. -->
  <canvas class="pointer-events-none absolute inset-0 -z-10 size-full" data-paint aria-hidden="true"></canvas>

  <div class="wrap flex flex-1 flex-col justify-end pt-28 pb-10 sm:pb-14">
    <div class="grid items-end gap-6 lg:grid-cols-[1fr_auto] lg:gap-10">
      <h1 class="display select-none text-[clamp(4.2rem,15.5vw,15.5rem)] font-extrabold" aria-label={profile.name}>
        {
          lines.map((line) => (
            <span class="block overflow-hidden pb-[0.06em]" aria-hidden="true">
              <span class="inline-block" data-line>
                {[...line].map((ch) => (
                  <span class="inline-block will-change-transform" data-char>
                    {ch}
                  </span>
                ))}
              </span>
            </span>
          ))
        }
      </h1>

      <div class="relative -order-1 justify-self-end lg:order-none" data-avatar>
        <div
          class="size-[clamp(7.5rem,19vw,19rem)] rotate-3 overflow-hidden rounded-[42%_58%_55%_45%/50%_45%_55%_50%] border-[6px] border-ink shadow-[10px_10px_0_0_var(--color-hoodie)] lg:shadow-[14px_14px_0_0_var(--color-hoodie)]"
        >
          <Image src={avatar} alt="成川 貴史のアバター（オレンジのパーカーを着たイラスト）" width={400} height={400} loading="eager" fetchpriority="high" class="size-full object-cover" />
        </div>
      </div>
    </div>

    <div class="mt-8 grid gap-6 border-t-2 border-ink pt-6 md:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] md:gap-12">
      <div>
        <p class="text-[clamp(1.15rem,2vw,1.6rem)] leading-snug font-semibold tracking-tight">
          <span data-stream data-text={profile.role}>{profile.role}</span><span
            class="ml-0.5 inline-block h-[1em] w-[0.5em] translate-y-[0.15em] bg-ink motion-safe:animate-[blink_1s_steps(2)_infinite]"
            aria-hidden="true"
            data-caret></span>
        </p>
        <p class="mt-1 text-[1rem] text-ink/75">
          {profile.org}／{profile.location}
        </p>
      </div>
      <div class="flex flex-col gap-5">
        <p class="max-w-[38rem] text-[1rem] leading-[1.9] text-ink/85">{profile.tagline}</p>
        <ul class="flex flex-wrap gap-2">
          {
            socials.map((s) => (
              <li>
                <a
                  href={s.href}
                  target="_blank"
                  rel="noopener me"
                  class="inline-flex items-center rounded-full border-2 border-ink px-4 py-1.5 text-[0.92rem] font-semibold transition-[background-color,color,transform] duration-300 ease-out-expo hover:-translate-y-0.5 hover:bg-ink hover:text-yolk"
                  data-magnet
                >
                  {s.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes blink {
    to {
      opacity: 0;
    }
  }
  [data-char] {
    font-variation-settings: 'wght' var(--w, 800), 'wdth' var(--s, 100);
    font-weight: 800;
  }
</style>

<script>
  import { initHero } from '~/scripts/hero'
  initHero()
</script>
