---
import { Image } from 'astro:assets'
import { profile } from '~/data/profile'
import { works } from '~/data/works'

// Frames follow each image's own shape, clamped so a 3.6:1 logo or a tall book cover still reads as a card.
const MIN_RATIO = 0.75
const MAX_RATIO = 2.6
const shape = (img: { width: number; height: number }) => {
  const natural = img.width / img.height
  const ratio = Math.min(MAX_RATIO, Math.max(MIN_RATIO, natural))
  return { ratio, fit: Math.abs(ratio - natural) > 0.01 ? 'contain' : 'cover' }
}
---

<section id="works" class="bg-paper py-24 sm:py-32" data-works>
  <div class="wrap">
    <div class="grid gap-6 md:grid-cols-[1fr_minmax(0,28rem)] md:items-end">
      <h2 class="display text-[clamp(3.2rem,9vw,8rem)] font-extrabold">Works</h2>
      <p class="text-[1rem] leading-[1.9] text-ink/75">
        登壇、寄稿、カンファレンス運営など。スライドは
        <a href={profile.links.speakerdeck} target="_blank" rel="noopener" class="font-semibold underline decoration-hoodie decoration-2">Speaker Deck</a>
        にまとめています。
      </p>
    </div>

    <ul class="mt-14 border-t-2 border-ink" data-work-list>
      {
        works.map((w, i) => (
          <li class="border-b border-line">
            <a
              href={w.url}
              target="_blank"
              rel="noopener"
              class="group grid grid-cols-[3.2rem_1fr] items-baseline gap-x-4 gap-y-1 py-5 sm:grid-cols-[4rem_1fr_12rem_6rem] sm:py-6"
              data-work={i}
            >
              <span class="text-[0.95rem] font-semibold text-mist tnum">{w.year}</span>
              <span class="relative text-[clamp(1.08rem,1.9vw,1.5rem)] leading-snug font-bold tracking-tight transition-transform duration-500 ease-out-expo group-hover:translate-x-3">
                {w.title}
              </span>
              <span class="col-start-2 text-[0.92rem] text-ink/70 sm:col-start-3">{w.venue}</span>
              <span class="col-start-2 text-[0.85rem] text-mist sm:col-start-4 sm:text-right">{w.kind}</span>
              <Image
                src={w.image}
                alt=""
                width={640}
                class="col-start-2 mt-3 max-h-48 w-auto max-w-full rounded-xl bg-yolk sm:hidden"
                style={`aspect-ratio:${shape(w.image).ratio};object-fit:${shape(w.image).fit}`}
                loading="lazy"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- One floating frame reused for every row; it chases the cursor with lag so the image feels carried. -->
  <div
    class="pointer-events-none fixed top-0 left-0 z-40 hidden h-64 w-[26rem] overflow-hidden rounded-2xl border-4 border-ink bg-yolk opacity-0 shadow-[10px_10px_0_0_var(--color-hoodie)] sm:block"
    data-preview
    aria-hidden="true"
  >
    {
      works.map((w, i) => (
        <Image
          src={w.image}
          alt=""
          width={720}
          class="absolute inset-0 size-full opacity-0"
          style={`object-fit:${shape(w.image).fit}`}
          loading="lazy"
          data-preview-img={i}
          data-ratio={shape(w.image).ratio}
          data-natural-width={w.image.width}
        />
      ))
    }
  </div>
</section>

<script>
  import { initWorks } from '~/scripts/works'
  initWorks()
</script>
