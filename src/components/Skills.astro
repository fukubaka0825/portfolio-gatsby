---
import { skills } from '~/data/skills'
---

<section id="skills" class="bg-paper pb-24 sm:pb-32">
  <div class="wrap">
    <div class="rounded-[2rem] bg-yolk p-6 sm:p-12">
      <h2 class="display text-[clamp(2.4rem,6vw,4.8rem)] font-extrabold">What I work with</h2>
      <dl class="mt-10 grid items-start gap-x-12 gap-y-8 lg:grid-cols-2">
        {
          skills.map((g) => (
            <div class="grid items-start gap-2 border-t-2 border-ink pt-4 sm:grid-cols-[10rem_1fr]">
              <dt class="text-[1.05rem] font-bold">{g.name}</dt>
              <dd class="flex flex-wrap content-start items-start gap-1.5">
                {g.items.map((s) => (
                  <span class="rounded-full bg-paper/70 px-3 py-1 text-[0.9rem] leading-tight whitespace-nowrap">{s}</span>
                ))}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
