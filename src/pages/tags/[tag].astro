---
import { type CollectionEntry, getCollection } from 'astro:content'
import PostList from '~/components/PostList.astro'
import Page from '~/layouts/Page.astro'

export async function getStaticPaths() {
  const posts = await getCollection('blog')
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))]
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }))
}

type Props = { tag: string; posts: CollectionEntry<'blog'>[] }
const { tag, posts } = Astro.props
---

<Page section="blog" title={`#${tag}`}>
  <div class="wrap max-w-5xl">
    <a href="/tags/" class="text-[0.95rem] font-semibold underline decoration-hoodie decoration-2">Tags</a>
    <h1 class="display mt-4 text-[clamp(3rem,8vw,7rem)] font-extrabold">#{tag}</h1>
    <div class="mt-12">
      <PostList posts={posts} />
    </div>
  </div>
</Page>
