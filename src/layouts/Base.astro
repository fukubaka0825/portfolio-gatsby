---
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url'
import '~/styles/global.css'
import Nav from '~/components/Nav.astro'
import { roles } from '~/data/career'
import { education } from '~/data/misc'
import { profile } from '~/data/profile'
import jpFontCss from '~/styles/jp-font.css?url'

type Props = {
  title?: string
  description?: string
  type?: 'website' | 'article'
  publishedAt?: Date
  /** Nav item to light up on pages that aren't sections of the home page. */
  section?: 'blog'
}

const { title, description = profile.description, type = 'website', publishedAt, section } = Astro.props
const fullTitle = title ? `${title} | ${profile.name}` : `${profile.name} (@${profile.handle})`
const canonical = new URL(Astro.url.pathname, Astro.site)
const ogImage = new URL('/og.png', Astro.site)
const current = roles.find((r) => r.lane === 'main' && r.end === null)

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.handle,
  jobTitle: current?.title,
  worksFor: { '@type': 'Organization', name: current?.company },
  url: Astro.site?.toString(),
  image: new URL('/avatar.jpg', Astro.site).toString(),
  sameAs: Object.values(profile.links),
  knowsAbout: profile.keywords,
  alumniOf: { '@type': 'CollegeOrUniversity', name: education.school },
}
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={profile.keywords.join(', ')} />
    <meta name="author" content={profile.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f5d33f" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="ja_JP" />
    {publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${profile.handle}`} />
    <meta name="twitter:creator" content={`@${profile.handle}`} />
    <meta name="twitter:image" content={ogImage} />

    <!-- The Latin display face drives the hero's first paint; fetch it before CSS discovers it. -->
    <link rel="preload" href={bricolageLatin} as="font" type="font/woff2" crossorigin />
    <!-- Japanese faces are huge; render with the system JP font first and swap in Zen Kaku when it arrives. -->
    <link rel="stylesheet" href={jpFontCss} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href={jpFontCss} /></noscript>

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    <slot name="head" />
  </head>
  <body data-section={section}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-chalk"
      >本文へスキップ</a
    >
    <Nav />
    <main id="main" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <script>
      import '~/scripts/smooth'
    </script>
  </body>
</html>
